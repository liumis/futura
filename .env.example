APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Laravel Cloud:
# - Connect this GitHub repo and set deploy command: php artisan migrate --force
# - Attach MySQL (and optional object storage / Redis). Cloud injects DB_* / AWS_* / REDIS_*.
# - Enable the scheduler and a queue worker in the environment.
# - Generate APP_KEY locally: php artisan key:generate --show
# - Set APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-app.laravel.cloud
# - Dual panels: INTERNAL_PANEL_DOMAIN and CUSTOMER_PANEL_DOMAIN (no path prefix).
# - Session cookies: SESSION_SECURE_COOKIE=true, keep SESSION_DOMAIN=null for split hosts.
# - Uploads: FILESYSTEM_DISK=s3 after attaching object storage (invoices/manual imports).

# Filament panel hostnames (Laravel Cloud dual subdomain).
# Leave empty for local single-host mode (admin at /, customer at /customer).
# Production example:
# INTERNAL_PANEL_DOMAIN=internal.example.com
# CUSTOMER_PANEL_DOMAIN=customers.example.com
INTERNAL_PANEL_DOMAIN=
CUSTOMER_PANEL_DOMAIN=

SESSION_SECURE_COOKIE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Keep null so internal.* and customers.* do not share login cookies.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Microsoft Outlook Calendar (delegated OAuth). Falls back to SharePoint Entra app credentials if unset.
MICROSOFT_CALENDAR_TENANT_ID=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI="/oauth/microsoft/calendar/callback"
